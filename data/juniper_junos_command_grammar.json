{
  "grammar_version": "1.0",
  "vendor_platform": "juniper_junos",
  "coverage_policy": "v1 covers common/template-used commands; unknown commands remain not_covered unless explicitly forbidden.",
  "rules": [
    {
      "pattern": "^(?:set|delete|deactivate|activate|rename|insert)\\\\s+.+$",
      "description": "Junos set command"
    },
    {
      "pattern": "^(?:configure|commit|commit\\\\s+check|exit|rollback|show)(?:\\\\s+.*)?$",
      "description": "Junos command"
    },
    {
      "pattern": "^[{};]$",
      "description": "Junos hierarchy delimiter"
    }
  ],
  "total_known_commands": 3,
  "uncovered_commands": [
    "vendor commands outside this grammar"
  ],
  "partially_covered": [
    "commands matched by syntax only when no semantic rule exists"
  ]
}
