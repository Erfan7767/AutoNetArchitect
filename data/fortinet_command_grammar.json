{
  "grammar_version": "1.0",
  "vendor_platform": "fortinet",
  "coverage_policy": "v1 covers common/template-used commands; unknown commands remain not_covered unless explicitly forbidden.",
  "rules": [
    {
      "pattern": "^config\\\\s+.+$",
      "description": "FortiOS config block"
    },
    {
      "pattern": "^edit\\\\s+.+$",
      "description": "FortiOS edit block"
    },
    {
      "pattern": "^set\\\\s+.+$",
      "description": "FortiOS set command"
    },
    {
      "pattern": "^unset\\\\s+.+$",
      "description": "FortiOS unset command"
    },
    {
      "pattern": "^append\\\\s+.+$",
      "description": "FortiOS append command"
    },
    {
      "pattern": "^(?:next|end)$",
      "description": "FortiOS block transition"
    },
    {
      "pattern": "^show(?:\\\\s+.+)?$",
      "description": "FortiOS show command"
    }
  ],
  "total_known_commands": 7,
  "uncovered_commands": [
    "vendor commands outside this grammar"
  ],
  "partially_covered": [
    "commands matched by syntax only when no semantic rule exists"
  ]
}
