        "phase2_failure",
        "traffic_not_encrypted",
        "split_tunnel_issue"
      ]
    },
    {
      "class": "dns_dhcp_issue",
      "subtypes": [
        "no_ip_address",
        "wrong_ip",
        "dns_resolution_failure",
        "dns_slow"
      ]
    },
    {
      "class": "device_issue",
      "subtypes": [
        "high_cpu",
        "high_memory",
        "process_crash",
        "hardware_failure",
        "power_issue"
      ]
    }
  ]
}
