{
  "version": "1.0",
  "policy": "keyword and structured matches are advisory; ambiguous inputs remain low confidence",
  "classes": [
    {
      "class": "connectivity_loss",
      "subtypes": [
        "total",
        "partial",
        "intermittent",
        "one_directional"
      ]
    },
    {
      "class": "performance_degradation",
      "subtypes": [
        "high_latency",
        "packet_loss",
        "jitter",
        "low_throughput",
        "application_slow"
      ]
    },
    {
      "class": "authentication_failure",
      "subtypes": [
        "login_failure",
        "intermittent_auth",
        "radius_timeout",
        "certificate_error",
        "vlan_assignment_wrong"
      ]
    },
    {
      "class": "routing_issue",
      "subtypes": [
        "unreachable",
        "suboptimal_path",
        "routing_loop",
        "route_flapping",
        "asymmetric_routing"
      ]
    },
    {
      "class": "l2_issue",
      "subtypes": [
        "broadcast_storm",
        "mac_flapping",
        "stp_issue",
        "vlan_issue",
        "trunk_issue"
      ]
    },
    {
      "class": "wireless_issue",
      "subtypes": [
        "no_association",
