# AutoNetArchitect V1 local configuration template
# Copy this file to .env for local development; never commit real values.
# The API creates and protects its signing key below AUTONET_API_ROOT when no
# programmatic key is supplied. V1 does not read a raw JWT secret from .env.

# Local API state and process boundary
AUTONET_API_ROOT=./runtime-data/api
AUTONET_API_HOST=127.0.0.1
AUTONET_API_PORT=8000
AUTONET_API_URL=http://127.0.0.1:8000

# Local wrappers and test-safe logging
PYTHONPATH=.
AUTONET_RUNTIME_MODE=local-single-user
AUTONET_LOG_LEVEL=INFO

# The following settings are intentionally not present because V1 does not
# consume them as configuration: AUTONET_DATABASE_PATH, AUTONET_SECURITY_VAULT_PATH,
# AUTONET_API_JWT_SECRET_KEY, AUTONET_API_CORS_ORIGINS, SSH timeout/concurrency
# variables, feature flags, and cache backend/size variables. Do not assume that
# an arbitrary environment variable changes application behavior.
